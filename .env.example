# Copia este archivo a ".env" y cambia los valores (NO subas .env a GitHub).
# Si no existe .env, docker-compose usa los valores por defecto de desarrollo.

# Secretos de clientes OAuth2 (auth-server)
POSTMAN_CLIENT_SECRET=postman-secret
WEB_FRONTEND_SECRET=web-frontend-secret
MOBILE_APP_SECRET=mobile-app-secret
ATM_TERMINAL_SECRET=atm-terminal-secret
BFF_WEB_SECRET=bff-web-secret
BFF_MOBILE_SECRET=bff-mobile-secret
BFF_ATM_SECRET=bff-atm-secret

# Usuarios finales (flujo authorization_code)
AUTH_CLIENTE_PASSWORD=cliente123
AUTH_ADMIN_PASSWORD=admin123

# Host publico anunciado por Kafka para clientes EXTERNOS al Docker.
# En AWS EC2 pon aqui la IP publica o DNS de la instancia. Local: localhost
KAFKA_EXTERNAL_HOST=localhost
